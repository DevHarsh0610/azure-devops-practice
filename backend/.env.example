# Server Environment
NODE_ENV=development
PORT=3000
API_VERSION=v1

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/taskdb?schema=public

# Security & JWT Secrets
# Generate strong secrets using: openssl rand -base64 32
JWT_ACCESS_SECRET=super-secure-access-token-secret-must-be-long-and-random-32-chars
JWT_REFRESH_SECRET=super-secure-refresh-token-secret-must-be-long-and-random-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cryptography Settings
BCRYPT_ROUNDS=12

# CORS Whitelist (Comma separated urls)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Logging
LOG_LEVEL=info
LOG_DIR=logs

# Swagger API Documentation Toggle
SWAGGER_ENABLED=true
